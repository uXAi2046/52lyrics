(catalog) {
	root * /srv/52lyrics/current
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	redir /top-charts /discover 308
	@private path /.git/* /.env /.env.*
	respond @private 404
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /artwork/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}/index.html /__spa-fallback.html
		file_server
	}
}

www.52lyrics.com {
	import catalog
}

http://43.135.135.12 {
	header X-Robots-Tag noindex
	import catalog
}
