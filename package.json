{
  "name": "52lyrics",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/generate-static.ts",
    "lint": "eslint .",
    "preview": "sirv build/client --single __spa-fallback.html",
    "check": "react-router typegen && tsc -b --noEmit",
    "catalog:import": "tsx scripts/import-wikisource.ts",
    "catalog:stats": "node --import tsx scripts/catalog/stats.mjs",
    "catalog:verify-sources": "node --import tsx scripts/catalog/verify-sources.mjs",
    "catalog:verify-build": "node --import tsx scripts/catalog/verify-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@react-router/node": "^7.18.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^7.18.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  }
}
